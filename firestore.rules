rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HILFSFUNKTIONEN ---

    function isSignedIn() {
      return request.auth != null;
    }

    // Muss mit der Liste in src/admins.js übereinstimmen!
    function isAdmin() {
      return isSignedIn()
        && request.auth.token.firebase.sign_in_provider == 'password'
        && request.auth.token.email.lower() in [
          'ivan.trombino@outlook.de',
          'cordula.buhl@gmail.com',
          'info@coffeemore.de' // Frank Veit
        ];
    }

    // Trainer = hat ein Profil in youth_coaches (wird nur von Admins angelegt)
    function isCoach() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/youth_coaches/$(request.auth.uid));
    }

    // Echte Accounts: Admins und Trainer (keine anonymen Ticker-Personen, keine selbst registrierten Accounts)
    function isStaff() {
      return isAdmin() || isCoach();
    }

    function coachProfile() {
      return get(/databases/$(database)/documents/youth_coaches/$(request.auth.uid)).data;
    }

    // Trainer, der für diese Mannschaft zuständig ist ("Jugendleitung" = alle Mannschaften)
    function coachHasTeam(team) {
      return isCoach()
        && ('Jugendleitung' in coachProfile().assignedTeams || team in coachProfile().assignedTeams);
    }

    // Stimmt der Code mit dem aktuellen, nicht abgelaufenen Tagescode des Vereins überein?
    function codeMatches(club, code) {
      let codeDoc = /databases/$(database)/documents/ticker_codes/$(club);
      return exists(codeDoc)
        && get(codeDoc).data.code == code
        && request.time < get(codeDoc).data.expiresAt;
    }

    // Ticker-Person mit gültigem Tagescode für diesen Verein
    function hasValidTickerSession(club) {
      let session = /databases/$(database)/documents/ticker_sessions/$(request.auth.uid);
      return isSignedIn()
        && exists(session)
        && get(session).data.clubId == club
        && codeMatches(club, get(session).data.code);
    }

    // --- TICKER-DOKUMENTE (IDs beginnen mit der Vereins-ID, z. B. "svon_live_match_F-Jugend") ---

    function tickerClub(docId) {
      return docId.split('_')[0];
    }

    // Was die Zuschauer-Ansicht braucht – öffentlich lesbar
    // (fussballde = Verknüpfung Mannschaft -> öffentliche fussball.de-Team-ID, für "Nächste Spiele")
    function isPublicTickerDoc(docId) {
      return docId.matches('[a-z0-9]+_(teams|matches|next_matches|fussballde|live_match_.*)');
    }

    // Spieldaten, die eine Ticker-Person mit Tagescode lesen bzw. schreiben darf
    function isMatchReadDoc(docId) {
      return docId.matches('[a-z0-9]+_(matches|next_matches|lineups|scorers|players|nameDisplay|live_match_.*)');
    }
    function isMatchWriteDoc(docId) {
      return docId.matches('[a-z0-9]+_(matches|next_matches|lineups|scorers|live_match_.*)');
    }

    // Vereins-Einstellungen und Initialen-Liste (aus der Jugenddatenbank): nur Admins
    function isAdminOnlyDoc(docId) {
      return docId.matches('[a-z0-9]+_(teams|pitches|teamCoaches|fussballde|closures|nameDisplay)');
    }

    // --- REGELN ---

    // 1. Basis-Sicherheit: Standardmäßig alles blockieren
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. DSGVO-Daten (Spieler, inkl. Gesundheitsdaten): Admins alles,
    //    Trainer nur Spieler ihrer eigenen Mannschaften (Jugendleitung: alle), ändern nur Admins
    match /youth_players/{player} {
      allow read: if isAdmin() || coachHasTeam(resource.data.youthTeam);
      allow write: if isAdmin();
    }

    // 3. Trainer-Profile: jeder nur sein eigenes, Admins alle; anlegen/ändern nur Admins
    match /youth_coaches/{coach} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == coach);
      allow write: if isAdmin();
    }

    // 4. Mannschaften & Jahrgänge: öffentlich lesbar, ändern nur Admins
    match /youth_settings/{setting} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 5. Trainingserfassung (Anwesenheit): Admins alles, Trainer nur ihre Mannschaften
    match /youth_trainings/{training} {
      allow read, delete: if isAdmin() || coachHasTeam(resource.data.team);
      allow create: if isAdmin() || coachHasTeam(request.resource.data.team);
      allow update: if isAdmin() || (coachHasTeam(resource.data.team) && coachHasTeam(request.resource.data.team));
    }

    // 5b. Sommercamp (Teilnehmer inkl. Allergien, Betreuer, Spenden, Preise/Gruppen): nur Admins
    match /summercamp_participants/{participant} {
      allow read, write: if isAdmin();
    }
    match /summercamp_staff/{member} {
      allow read, write: if isAdmin();
    }
    match /summercamp_donations/{donation} {
      allow read, write: if isAdmin();
    }
    match /summercamp_settings/{club} {
      allow read, write: if isAdmin();
    }

    // 5c. Spieltags-Zu-/Absage: Trainer verwalten Termine ihrer Mannschaften.
    //     Eltern öffnen den geteilten Link (nicht erratbare Termin-ID) und antworten ohne Anmeldung –
    //     nur für Kinder aus dem Termin, nur solange er offen ist, nur Status + kurzer Kommentar.
    function attendanceEvent(eventId) {
      return get(/databases/$(database)/documents/attendance_events/$(eventId)).data;
    }
    match /attendance_events/{eventId} {
      allow get: if true;
      allow list: if isAdmin() || coachHasTeam(resource.data.team);
      allow create: if isAdmin() || coachHasTeam(request.resource.data.team);
      allow update: if isAdmin() || (coachHasTeam(resource.data.team) && coachHasTeam(request.resource.data.team));
      allow delete: if isAdmin() || coachHasTeam(resource.data.team);

      match /responses/{playerKey} {
        allow read: if true;
        allow create, update: if exists(/databases/$(database)/documents/attendance_events/$(eventId))
          && attendanceEvent(eventId).closed == false
          && playerKey in attendanceEvent(eventId).rosterKeys
          && request.resource.data.keys().hasOnly(['status', 'comment', 'updatedAt'])
          && request.resource.data.status in ['yes', 'no', 'maybe']
          && request.resource.data.comment is string
          && request.resource.data.comment.size() <= 200
          && request.resource.data.updatedAt == request.time;
        allow delete: if isAdmin() || coachHasTeam(attendanceEvent(eventId).team);
      }
    }

    // 6. Ticker-Tagescodes: Trainer erzeugen/sehen den Code, Ticker-Personen nur mit gültigem Code
    match /ticker_codes/{club} {
      allow read: if isStaff() || hasValidTickerSession(club);
      allow write: if isStaff();
    }

    // 7. Ticker-Sitzungen: Anlegen nur mit korrektem, gültigem Tagescode
    match /ticker_sessions/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create, update: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['clubId', 'code'])
        && request.resource.data.clubId is string
        && request.resource.data.code is string
        && codeMatches(request.resource.data.clubId, request.resource.data.code);
    }

    // 8. Spielticker & Platzbelegung
    //    Lesen: Zuschauer-Daten öffentlich, alles andere nur Trainer/Admins bzw. Spieldaten für Ticker-Personen
    //    Schreiben: Admins alles, Trainer alles außer Vereins-Einstellungen, Ticker-Personen nur Spieldaten
    match /ticker/{docId} {
      allow read: if isPublicTickerDoc(docId)
        || isStaff()
        || (isMatchReadDoc(docId) && hasValidTickerSession(tickerClub(docId)));
      allow write: if isAdmin();
      allow write: if !isAdminOnlyDoc(docId) && isStaff();
      allow write: if isMatchWriteDoc(docId) && hasValidTickerSession(tickerClub(docId));
    }
  }
}
